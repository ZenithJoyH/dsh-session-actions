{
  "name": "dsh-session-actions",
  "version": "0.3.0",
  "description": "DSH web plugin: session actions in the sidebar—mark unread, delete any non-running session directly (no archiving required). DSH Web 插件：会话操作——标为未读，直接删除任意未运行会话。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenithJoyH/dsh-session-actions.git"
  },
  "homepage": "https://github.com/ZenithJoyH/dsh-session-actions#readme",
  "bugs": {
    "url": "https://github.com/ZenithJoyH/dsh-session-actions/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "archive",
    "delete",
    "unread"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node test/host.test.mjs && node test/client.smoke.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
